# Variable names only. No values live in this file, and none are committed.
#
#   cp node_modules/@epf-mde/moodle-publisher/.env.example .env
#
# at the root of the course repository, then fill it in and git-ignore it. The
# run state below defaults to paths under the directory the publisher is started
# in; the session state alone lives outside it.
#
# The publisher reads .env if it is there, and runs without one if it
# is not. The file is the lower layer: anything exported in the shell overrides
# it, so a one-off run against a scratch course is never quietly redirected by
# a file you forgot was in the working copy.
#
#   MOODLE_COURSE_ID=771 npx moodle-publisher publish --apply   # 771, whatever .env says
#
# Syntax: KEY=value, one per line, `#` comments, optional quotes, and an
# optional `export` prefix. `KEY=` with nothing after it means "not set".

# The Moodle site, e.g. the EPF instance. Required.
MOODLE_BASE_URL=

# The id of the course to publish into. Required, and there is no default:
# a missing value aborts the run rather than picking a course.
MOODLE_COURSE_ID=

# Where Playwright's session state is kept. Optional; defaults to
# ~/.config/epf-moodle-publisher/session.json, which is outside the course repository.
# Treat it as a secret: it is a live Moodle session. Never commit it.
MOODLE_SESSION_STATE=

# Root directory for timestamped run directories holding before/after
# screenshots. Optional; defaults to runs/ at the repository root; git-ignore it.
MOODLE_RUN_DIR=

# Which env file to read, when it should not be .env. Optional, and
# read only from the real environment — an env file cannot name another one.
# A file named here and not found aborts the run, rather than being treated as
# no configuration at all.
PUBLISHER_ENV_FILE=

# The repository root, when it is not the directory the run starts in. Optional.
# Read only from the real environment: the .env is found at the root, so it
# cannot move it.
PUBLISHER_REPO_ROOT=

# Where the manifest is kept. Optional; defaults to moodle-manifest.json at the
# repository root, where it is committed.
PUBLISHER_MANIFEST=

# --- Test-only overrides. Leave all of these unset when publishing. ---
# The test suite sets them to drive the command line against the fake driver
# with a temporary repository of fixture documents. What a run publishes is
# never set here: it is the publisher.json at the repository root, for every
# run. PUBLISHER_NOW is honoured only when PUBLISHER_DRIVER=fake, so the date
# used against a real course cannot be changed by the environment.
PUBLISHER_DRIVER=
PUBLISHER_FAKE_COURSE=

# The date the audit measures its reveal gate against — whether the C3 brief is
# still meant to be hidden. Optional; the clock when unset. An ISO date or
# timestamp; anything else aborts rather than falling back to the clock.
#
# It is how the suite tests both sides of 11 September on any day. Against a
# real course it is ignored outright: it writes nothing, but a stale value here
# would turn a brief opened a week early into "Audit passed", and that is not a
# trade worth making on the guard that matters most.
PUBLISHER_NOW=
